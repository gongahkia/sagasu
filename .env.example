# Private local agent runtime. No messaging-service credentials are needed.
SAGASU_BROWSER_CHANNEL=chromium
SAGASU_MCP_CONFIRMATION=agent
# auto: direct FBS search/account reads with browser fallback on known failures.
# browser: always use browser reads. api: direct reads with no browser fallback.
# backend-probe --live compares HTTP results with Chromium using your saved session.
SAGASU_READ_BACKEND=auto
# Optional host-side Microsoft sign-in autofill (never send passwords to an agent):
# SMU_LOGIN_EMAIL=your.name@smu.edu.sg
# SMU_LOGIN_PASSWORD='your-private-password'
# You still approve Microsoft Authenticator on your phone.
# Optional overrides:
# SAGASU_HEADLESS=true
# SAGASU_BROWSER_PROFILE=/absolute/path/to/private/browser
# SAGASU_PREFERENCES_PATH=/absolute/path/to/private/personal.sqlite3
# SAGASU_JOURNAL_PATH=/absolute/path/to/private/actions.sqlite3
# SAGASU_AUTH_TIMEOUT_MS=600000
# SAGASU_STAY_SIGNED_IN=true
