BOT_TOKEN=replace-with-your-telegram-bot-token
# Strongly recommended for personal deployments. Get it from Telegram @userinfobot.
TELEGRAM_OWNER_ID=123456789
# Optional automatic Microsoft sign-in. Keep these private; never send to Telegram.
# Password autofill requires both the email and TELEGRAM_OWNER_ID above.
# SMU_LOGIN_EMAIL=your.name@smu.edu.sg
# SMU_LOGIN_PASSWORD='your-private-password'
# You approve MFA on your phone; Sagasu privately sends the matching number.

# Optional overrides:
# SAGASU_BROWSER_CHANNEL=chromium
# SAGASU_HEADLESS=true  # Run without a desktop on a remote host
# SAGASU_BROWSER_PROFILE=/absolute/path/to/a/private/chrome-profile
# SAGASU_AUTH_TIMEOUT_MS=600000
# SAGASU_STAY_SIGNED_IN=true

# Optional CLI state override (defaults to bot/bot_state.pickle in a checkout):
# SAGASU_STATE_PATH=/absolute/path/to/private/bot_state.pickle
