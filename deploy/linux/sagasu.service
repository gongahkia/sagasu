[Unit]
Description=Sagasu personal Telegram room booking bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=sagasu
Group=sagasu
WorkingDirectory=/var/lib/sagasu
StateDirectory=sagasu
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/sagasu-host run --no-spinner --no-color --log-format json --log-file /var/lib/sagasu/sagasu.jsonl
Restart=always
RestartSec=15
TimeoutStopSec=90
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sagasu

[Install]
WantedBy=multi-user.target
