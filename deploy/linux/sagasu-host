#!/usr/bin/env bash
# Use identical browser/state paths for the service and manual diagnostics.
set -euo pipefail

if [[ $EUID -eq 0 ]]; then
    exec runuser -u sagasu -- /usr/local/bin/sagasu-host "$@"
fi
if [[ $(id -un) != sagasu ]]; then
    printf '%s\n' 'Run this command with sudo: sudo sagasu-host COMMAND' >&2
    exit 2
fi

export PLAYWRIGHT_BROWSERS_PATH=/var/lib/sagasu/browsers
export SAGASU_HEADLESS=true
export SAGASU_BROWSER_CHANNEL=chromium
export SAGASU_BROWSER_PROFILE=/var/lib/sagasu/profile
export SAGASU_STATE_PATH=/var/lib/sagasu/bot_state.pickle
export SAGASU_AUTH_ARTIFACT_DIR=/var/lib/sagasu/auth
export PYTHONUNBUFFERED=1
cd /var/lib/sagasu
exec /opt/sagasu/venv/bin/sagasu --env-file /etc/sagasu/sagasu.env "$@"
