# Edit these values privately on the VM with sudoedit.
BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_OWNER_ID=
SMU_LOGIN_EMAIL=
SMU_LOGIN_PASSWORD=
# Quote passwords containing # or spaces. Values are parsed by python-dotenv,
# not by a shell or systemd EnvironmentFile. Never source this file.
# Browser/session/state locations and headless mode are set by sagasu-host.
