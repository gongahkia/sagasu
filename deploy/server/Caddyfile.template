# Publishes only Sagasu's MCP endpoint, with an automatic TLS certificate.
{
	servers {
		# Slow or stalled clients are cut off instead of holding connections.
		timeouts {
			read_header 10s
			read_body 30s
			write 2m
			idle 2m
		}
	}
}

@PUBLIC_HOST@ {
	# The MCP endpoint, and the OAuth sign-in paths (Sagasu answers 401 for
	# them unless SAGASU_HTTP_OAUTH=on).
	@mcp path /mcp /sign-in /sign-in/* /authorize /token /register /revoke /oauth/sign-in /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server
	handle @mcp {
		request_body {
			max_size 4MB
		}
		reverse_proxy unix//run/sagasu/http.sock {
			flush_interval -1
		}
	}
	handle {
		respond "Not found" 404
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
}

# Teammates' copies, one file each (sagasu-ctl instance-add).
import /etc/caddy/sites/*.caddy
