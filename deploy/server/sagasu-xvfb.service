[Unit]
Description=Virtual display for the Sagasu browser
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
User=sagasu
Group=sagasu
UMask=0077
# A fresh access cookie on every start; only the sagasu user can read it.
ExecStartPre=/bin/sh -c 'rm -f /var/lib/sagasu/.Xauthority && touch /var/lib/sagasu/.Xauthority && xauth -f /var/lib/sagasu/.Xauthority add :99 . "$(mcookie)"'
ExecStart=/usr/bin/Xvfb :99 -screen 0 1600x1200x24 -nolisten tcp -auth /var/lib/sagasu/.Xauthority
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
