#!/usr/bin/python3
"""Small admin helper for a Sagasu server. Run with sudo.

For a copy (the owner's, or a teammate's with --instance NAME):
  sagasu-ctl [--instance NAME] status            services, address, keys, settings
  sagasu-ctl [--instance NAME] writes on|off     let agents book/amend/cancel, or not
  sagasu-ctl [--instance NAME] oauth on|off      let apps sign in with a key once
  sagasu-ctl [--instance NAME] connections       apps signed in through OAuth
  sagasu-ctl [--instance NAME] key-add LABEL     create an API key; shown once
  sagasu-ctl [--instance NAME] key-remove LABEL  revoke an API key
  sagasu-ctl [--instance NAME] restart           restart that copy
  sagasu-ctl [--instance NAME] logs              last 80 lines of its private log

For the owner only, to give a teammate a copy signed in to their own account:
  sagasu-ctl instance-list
  sagasu-ctl instance-add NAME                   create a copy with its own address
  sagasu-ctl access-add NAME 'ssh-ed25519 AAAA...'   let the teammate's SSH key in
  sagasu-ctl access-remove NAME
  sagasu-ctl instance-remove NAME --yes          delete the copy and its data
"""

import datetime
import glob
import hashlib
import os
import pwd
import re
import secrets
import shutil
import sqlite3
import subprocess
import sys

OWNER_ENV = "/etc/sagasu/sagasu.env"
INSTANCES = "/etc/sagasu/instances"
SITES = "/etc/caddy/sites"
SSH_KEYS = "/etc/ssh/sagasu_keys"
KIT = "/opt/sagasu/app/deploy/server"
LABEL = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}")
NAME = re.compile(r"[a-z][a-z0-9]{1,15}")
RESERVED = {"owner", "root", "admin", "www", "mail", "sagasu", "api", "mcp"}
PUBLIC_KEY = re.compile(
    r"(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521"
    r"|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)"
    r" ([A-Za-z0-9+/]{40,8192}={0,2})(?: [ -~]{0,200})?"
)


class Copy:
    """Where one copy of Sagasu keeps its settings, state and services."""

    def __init__(self, name=None):
        self.name = name
        if name:
            self.env = f"/etc/sagasu/{name}.env"
            self.state = f"/var/lib/sagasu-{name}"
            self.account = f"sagasu-{name}"
            self.units = (f"sagasu-xvfb@{name}", f"sagasu@{name}")
            self.launch = ["/opt/sagasu/bin/sagasu-launch", "--instance", name]
        else:
            self.env = OWNER_ENV
            self.state = "/var/lib/sagasu"
            self.account = "sagasu"
            self.units = ("sagasu-xvfb", "sagasu")
            self.launch = ["/opt/sagasu/bin/sagasu-launch"]
        self.oauth_store = f"{self.state}/oauth.sqlite3"


def read(copy):
    with open(copy.env, encoding="utf-8") as stream:
        return stream.read().splitlines()


ASSIGNMENT = re.compile(r"\s*(?:export\s+)?'?([A-Za-z_][A-Za-z0-9_]*)'?\s*=(.*)")
PLAIN = re.compile(r"[A-Za-z0-9_.:,/@-]*")
KEY_ENTRY = re.compile(r"[a-z0-9][a-z0-9_-]{0,31}:[0-9a-f]{64}")


def value(lines, name, default="", path=OWNER_ENV):
    """The value the service will use: the last assignment, in plain form only."""
    found = default
    for line in lines:
        match = ASSIGNMENT.fullmatch(line)
        if match and match.group(1) == name:
            if not line.startswith(name + "=") or not PLAIN.fullmatch(match.group(2)):
                sys.exit(
                    f"{path}: write the {name} line as plain {name}=value "
                    "(no quotes, spaces, export or trailing comment), then run this again."
                )
            found = match.group(2)
    return found


def write_file(path, text, group, mode=0o640):
    temporary = path + ".new"
    descriptor = os.open(temporary, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, mode)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(text)
    subprocess.run(["chown", f"root:{group}", temporary], check=True)
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def write(copy, lines, name, new):
    value(lines, name, path=copy.env)  # refuse a line this tool cannot edit safely
    kept = [line for line in lines if not line.startswith(name + "=")]
    position = next(
        (i for i, line in enumerate(lines) if line.startswith(name + "=")), len(kept)
    )
    kept.insert(min(position, len(kept)), f"{name}={new}")
    write_file(copy.env, "\n".join(kept) + "\n", copy.account)


def keys(copy, lines):
    entries = [
        item
        for item in value(lines, "SAGASU_HTTP_KEYS", path=copy.env).split(",")
        if item
    ]
    if not all(KEY_ENTRY.fullmatch(item) for item in entries):
        sys.exit(
            f"{copy.env}: SAGASU_HTTP_KEYS is not a list of label:sha256hex entries. "
            "Correct it by hand first."
        )
    return dict(item.split(":", 1) for item in entries)


def save_keys(copy, lines, current):
    write(
        copy,
        lines,
        "SAGASU_HTTP_KEYS",
        ",".join(f"{k}:{v}" for k, v in current.items()),
    )


def connections(copy):
    """(key label, app name, redirect host, signed in) for each live OAuth grant."""
    if not os.path.exists(copy.oauth_store):
        return []
    labels = {digest: label for label, digest in keys(copy, read(copy)).items()}
    database = sqlite3.connect(f"file:{copy.oauth_store}?mode=ro", uri=True)
    try:
        rows = database.execute(
            """SELECT g.key_digest, g.client_name, g.redirect_host, g.created
               FROM grants g WHERE EXISTS (
                 SELECT 1 FROM tokens t WHERE t.grant_id = g.grant_id
                 AND t.kind = 'refresh' AND t.expires > strftime('%s', 'now'))
               ORDER BY g.created"""
        ).fetchall()
    finally:
        database.close()
    return [
        (
            labels.get(digest, "(key removed)"),
            name or "?",
            host or "?",
            datetime.datetime.fromtimestamp(created).strftime("%d %b %H:%M"),
        )
        for digest, name, host, created in rows
    ]


def restart(copy):
    print("Restarting Sagasu (this closes the server's browser).")
    subprocess.run(["systemctl", "restart", copy.units[1]], check=True)
    print(
        "Done. If agents then report that sign-in is needed, sign in again"
        " (the same sign-in command as the first time)."
    )


def copy_command(copy, arguments):
    command = arguments[0] if arguments else ""
    lines = read(copy)
    if command == "status" and len(arguments) == 1:
        for unit in (*copy.units, "caddy"):
            state = subprocess.run(
                ["systemctl", "is-active", unit], capture_output=True, text=True
            ).stdout.strip()
            print(f"{unit:20} {state}")
        host = value(lines, "SAGASU_HTTP_ALLOWED_HOSTS", path=copy.env).split(",")[0]
        print(f"{'address':20} https://{host}/mcp")
        print(
            f"{'remote writes':20} {value(lines, 'SAGASU_HTTP_WRITES', 'off', copy.env)}"
        )
        print(
            f"{'oauth sign-in':20} {value(lines, 'SAGASU_HTTP_OAUTH', 'off', copy.env)}"
            f" ({len(connections(copy))} app(s) signed in)"
        )
        print(f"{'api keys':20} {', '.join(sorted(keys(copy, lines))) or 'none'}")
        sys.stdout.flush()
        subprocess.run([*copy.launch, "host", "status"])
    elif command in {"writes", "oauth"} and arguments[1:] in (["on"], ["off"]):
        setting = "SAGASU_HTTP_WRITES" if command == "writes" else "SAGASU_HTTP_OAUTH"
        write(copy, lines, setting, arguments[1])
        print(
            ("Remote writes" if command == "writes" else "OAuth sign-in"),
            "is now",
            arguments[1] + ".",
        )
        restart(copy)
    elif command == "connections" and len(arguments) == 1:
        rows = connections(copy)
        if not rows:
            print("No apps are signed in through OAuth.")
        for label, name, host, created in rows:
            print(f"{label:12} {name[:30]:30} {host:24} since {created}")
        if rows:
            print("To sign one out, remove or replace its key (key-remove LABEL).")
    elif command == "key-add" and len(arguments) == 2:
        label, current = arguments[1], keys(copy, lines)
        if not LABEL.fullmatch(label) or label in current or len(current) >= 16:
            sys.exit(
                "Use a new label: lowercase letters, digits, - or _ (at most 16 keys)."
            )
        key = "sgs_" + secrets.token_urlsafe(32)
        current[label] = hashlib.sha256(key.encode()).hexdigest()
        save_keys(copy, lines, current)
        print(
            f"API key '{label}' (shown once; keep it in a password manager):\n\n  {key}\n"
        )
        restart(copy)
    elif command == "key-remove" and len(arguments) == 2:
        current = keys(copy, lines)
        if arguments[1] not in current:
            sys.exit("No key has that label.")
        if len(current) == 1:
            sys.exit("This is the only key. Add its replacement first with key-add.")
        del current[arguments[1]]
        save_keys(copy, lines, current)
        print(f"API key '{arguments[1]}' no longer works.")
        restart(copy)
    elif command == "restart" and len(arguments) == 1:
        restart(copy)
    elif command == "logs" and len(arguments) == 1:
        subprocess.run(["tail", "-n", "80", f"{copy.state}/host.log"])
    else:
        sys.exit(__doc__)


# -- the owner's commands for teammates' copies ---------------------------------


def instance_settings(name):
    settings = {}
    with open(f"{INSTANCES}/{name}", encoding="utf-8") as stream:
        for line in stream:
            key, _, val = line.strip().partition("=")
            settings[key] = val
    return settings


def instance_names():
    return sorted(
        os.path.basename(path)
        for path in glob.glob(f"{INSTANCES}/*")
        if NAME.fullmatch(os.path.basename(path))
    )


def check_name(name, exists):
    if not NAME.fullmatch(name or "") or name in RESERVED:
        sys.exit(
            "Use a name of 2 to 16 lowercase letters and digits, starting with a letter."
        )
    if exists != os.path.exists(f"{INSTANCES}/{name}"):
        sys.exit(
            f"A copy named {name} already exists."
            if not exists
            else f"There is no copy named {name}."
        )


def reload_caddy():
    check = subprocess.run(
        ["caddy", "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"],
        capture_output=True,
        text=True,
    )
    if check.returncode != 0:
        return False
    subprocess.run(["systemctl", "reload", "caddy"], check=True)
    return True


def instance_add(name):
    check_name(name, exists=False)
    owner = read(Copy())
    base = value(owner, "SAGASU_HTTP_ALLOWED_HOSTS").split(",")[0]
    used = {int(instance_settings(other)["INDEX"]) for other in instance_names()}
    index = next((number for number in range(1, 21) if number not in used), None)
    if index is None:
        sys.exit("This server already holds 20 copies.")
    copy = Copy(name)
    host = f"{name}.{base}"
    socket = f"/run/sagasu-{name}/http.sock"
    subprocess.run(
        [
            "useradd",
            "--system",
            "--user-group",
            "--home-dir",
            copy.state,
            "--shell",
            "/usr/sbin/nologin",
            "--no-create-home",
            copy.account,
        ],
        check=True,
    )
    os.makedirs(copy.state, mode=0o700, exist_ok=True)
    shutil.chown(copy.state, copy.account, copy.account)
    os.chmod(copy.state, 0o700)
    os.makedirs(INSTANCES, mode=0o755, exist_ok=True)
    write_file(
        f"{INSTANCES}/{name}",
        f"INDEX={index}\nDISPLAY_NUM={99 + index}\nVNC_PORT={5910 + index}\n"
        f"WS_PORT={6090 + index}\nHOST={host}\n",
        "root",
        0o644,
    )
    # The copy needs one key to start. Nobody ever sees this one: the teammate
    # creates their own keys and can then remove it.
    unused = hashlib.sha256(secrets.token_bytes(32)).hexdigest()
    write_file(
        copy.env,
        "\n".join(
            [
                f"# Sagasu copy for {name}. Signed in to {name}'s own SMU account only.",
                "SAGASU_BROWSER_CHANNEL=chromium",
                f"SAGASU_BROWSER_PROFILE={copy.state}/profile",
                f"SAGASU_PREFERENCES_PATH={copy.state}/personal.sqlite3",
                f"SAGASU_JOURNAL_PATH={copy.state}/actions.sqlite3",
                f"SAGASU_AUTH_ARTIFACT_DIR={copy.state}/auth",
                "SAGASU_READ_BACKEND=auto",
                "SAGASU_MCP_CONFIRMATION=agent",
                "SAGASU_STAY_SIGNED_IN=false",
                "SAGASU_AUTH_TIMEOUT_MS=900000",
                "SAGASU_SESSION_COOKIES=fbs",
                f"SAGASU_HTTP_SOCKET={socket}",
                f"SAGASU_HTTP_ALLOWED_HOSTS={host}",
                f"SAGASU_HTTP_KEYS=setup:{unused}",
                "SAGASU_HTTP_WRITES=off",
                "SAGASU_HTTP_OAUTH=on",
                "",
            ]
        ),
        copy.account,
    )
    with open(f"{KIT}/Caddysite.template", encoding="utf-8") as stream:
        site = stream.read().replace("@HOST@", host).replace("@SOCKET@", socket)
    os.makedirs(SITES, mode=0o755, exist_ok=True)
    write_file(f"{SITES}/{name}.caddy", site, "root", 0o644)
    if not reload_caddy():
        os.remove(f"{SITES}/{name}.caddy")
        sys.exit("The web proxy rejected the new site; the copy was not published.")
    subprocess.run(["systemctl", "enable", "--now", *copy.units], check=True)
    print(
        f"Created the copy '{name}'.\n"
        f"  Address:  https://{host}/mcp\n"
        f"  Next: ask {name} for an SSH public key, then run\n"
        f"        sudo sagasu-ctl access-add {name} 'ssh-ed25519 AAAA...'"
    )


def access_add(name, key_text):
    check_name(name, exists=True)
    match = PUBLIC_KEY.fullmatch(key_text.strip())
    if not match:
        sys.exit("That is not an SSH public key (it should start with ssh-ed25519 or ssh-rsa).")
    settings = instance_settings(name)
    login = f"fbs-{name}"
    try:
        pwd.getpwnam(login)
    except KeyError:
        subprocess.run(
            [
                "useradd",
                "--system",
                "--user-group",
                "--shell",
                "/bin/sh",
                "--home-dir",
                "/nonexistent",
                "--no-create-home",
                login,
            ],
            check=True,
        )
    # No password at all ("*"), rather than a locked account: key login only.
    subprocess.run(["usermod", "-p", "*", login], check=True)
    os.makedirs(SSH_KEYS, mode=0o755, exist_ok=True)
    options = ",".join(
        [
            "restrict",
            "pty",
            "port-forwarding",
            f'permitopen="127.0.0.1:{settings["VNC_PORT"]}"',
            f'permitopen="127.0.0.1:{settings["WS_PORT"]}"',
            f'command="/opt/sagasu/bin/sagasu-self {name}"',
        ]
    )
    write_file(
        f"{SSH_KEYS}/{login}",
        f"{options} {match.group(1)} {match.group(2)} sagasu-{name}\n",
        "root",
        0o644,
    )
    rule = (
        f"{login} ALL=(root) NOPASSWD: /opt/sagasu/bin/sagasu-self {name}, "
        f"/opt/sagasu/bin/sagasu-self {name} *\n"
    )
    candidate = f"/etc/sudoers.d/.sagasu-{name}.new"
    write_file(candidate, rule, "root", 0o440)
    if subprocess.run(["visudo", "-cf", candidate], capture_output=True).returncode:
        os.remove(candidate)
        sys.exit("sudo rejected the rule; nothing was changed.")
    os.replace(candidate, f"/etc/sudoers.d/sagasu-{name}")
    address = settings["HOST"]
    print(
        f"{name} can now sign in to their own copy.\n"
        f"  Their login:   {login}@<server address>\n"
        f"  Their address: https://{address}/mcp\n"
        f"  Their view port on the server: {settings['WS_PORT']}"
    )


def access_remove(name):
    check_name(name, exists=True)
    login = f"fbs-{name}"
    for path in (f"{SSH_KEYS}/{login}", f"/etc/sudoers.d/sagasu-{name}"):
        if os.path.exists(path):
            os.remove(path)
    subprocess.run(["pkill", "-u", login], capture_output=True)
    subprocess.run(["userdel", login], capture_output=True)
    print(f"{name}'s SSH access is removed. Their copy keeps running.")


def instance_remove(name):
    check_name(name, exists=True)
    copy = Copy(name)
    access_remove(name)
    subprocess.run(["systemctl", "disable", "--now", *copy.units], capture_output=True)
    site = f"{SITES}/{name}.caddy"
    if os.path.exists(site):
        os.remove(site)
        reload_caddy()
    try:
        uid = pwd.getpwnam(copy.account).pw_uid
    except KeyError:
        uid = None
    for path in (copy.state, f"/run/sagasu-{name}", f"/tmp/sagasu-{uid}" if uid else ""):
        if path and os.path.exists(path):
            shutil.rmtree(path, ignore_errors=True)
    for path in (copy.env, f"{INSTANCES}/{name}"):
        if os.path.exists(path):
            os.remove(path)
    subprocess.run(["userdel", copy.account], capture_output=True)
    print(f"The copy '{name}' and its saved sign-in and data are deleted.")


def instance_list():
    names = instance_names()
    if not names:
        print("No teammate copies.")
    for name in names:
        settings = instance_settings(name)
        state = subprocess.run(
            ["systemctl", "is-active", f"sagasu@{name}"], capture_output=True, text=True
        ).stdout.strip()
        access = "yes" if os.path.exists(f"{SSH_KEYS}/fbs-{name}") else "no"
        print(
            f"{name:16} {state:10} ssh access: {access:4} https://{settings['HOST']}/mcp"
        )


def main(arguments):
    if os.geteuid() != 0:
        sys.exit("Run with sudo: sudo sagasu-ctl ...")
    if arguments[:1] == ["--instance"]:
        if len(arguments) < 2:
            sys.exit(__doc__)
        check_name(arguments[1], exists=True)
        copy_command(Copy(arguments[1]), arguments[2:])
        return
    command = arguments[0] if arguments else ""
    owner_only = {
        "instance-add",
        "instance-remove",
        "instance-list",
        "access-add",
        "access-remove",
    }
    if command in owner_only and os.environ.get("SUDO_USER", "").startswith("fbs-"):
        sys.exit("Only the server's owner can do that.")
    if command == "instance-list" and len(arguments) == 1:
        instance_list()
    elif command == "instance-add" and len(arguments) == 2:
        instance_add(arguments[1])
    elif command == "instance-remove" and arguments[2:] == ["--yes"]:
        instance_remove(arguments[1])
    elif command == "access-add" and len(arguments) >= 3:
        access_add(arguments[1], " ".join(arguments[2:]))
    elif command == "access-remove" and len(arguments) == 2:
        access_remove(arguments[1])
    else:
        copy_command(Copy(), arguments)


if __name__ == "__main__":
    main(sys.argv[1:])
