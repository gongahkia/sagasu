# Sagasu as a supervised service with a remote listener. Root-owned, group sagasu, mode 0640.
# Changes take effect after: sudo systemctl restart sagasu
SAGASU_BROWSER_CHANNEL=chromium
SAGASU_BROWSER_PROFILE=/var/lib/sagasu/profile
SAGASU_PREFERENCES_PATH=/var/lib/sagasu/personal.sqlite3
SAGASU_JOURNAL_PATH=/var/lib/sagasu/actions.sqlite3
SAGASU_AUTH_ARTIFACT_DIR=/var/lib/sagasu/auth
SAGASU_READ_BACKEND=auto
SAGASU_MCP_CONFIRMATION=agent

# Sign-in is done by a person, in the server's own browser (sudo sagasu-signin).
# Never set SMU_LOGIN_PASSWORD here; the service refuses to start if it is set.
# The person chooses "Stay signed in" on Microsoft's page; Sagasu does not click it.
SAGASU_STAY_SIGNED_IN=false
# How long a sign-in may take, in milliseconds. Matches the 15 minutes that
# sagasu-signin keeps its view open.
SAGASU_AUTH_TIMEOUT_MS=900000
# Keep only FBS cookies in the saved session file, not Microsoft's.
SAGASU_SESSION_COOKIES=fbs

# Remote listener: a private socket file, published by Caddy with TLS.
SAGASU_HTTP_SOCKET=/run/sagasu/http.sock
SAGASU_HTTP_ALLOWED_HOSTS=@PUBLIC_HOST@
# label:sha256-hex of each API key. The keys themselves are never stored here.
SAGASU_HTTP_KEYS=@KEY_DIGESTS@
# off: remote agents can search and read. on: they can also book, amend and cancel.
SAGASU_HTTP_WRITES=off
# on: apps that only connect through OAuth (ChatGPT, Claude's "Sign in") can be
# set up by typing an API key once on this server's own sign-in page.
SAGASU_HTTP_OAUTH=on
# Apps that may receive a sign-in: their redirect must be on one of these hosts.
# SAGASU_OAUTH_REDIRECT_HOSTS=chatgpt.com,claude.ai,claude.com,localhost,127.0.0.1
