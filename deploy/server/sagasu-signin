#!/usr/bin/env bash
# Sign in to SMU in the server's own browser, through a temporary view that is
# reachable only over an SSH connection. Sagasu types nothing: you do.
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    printf '%s\n' 'Run with sudo: sudo sagasu-signin' >&2
    exit 2
fi
for unit in sagasu-xvfb sagasu; do
    if ! systemctl is-active --quiet "$unit"; then
        printf '%s\n' "$unit is not running. Start it first: sudo systemctl start sagasu" >&2
        exit 1
    fi
done
if pgrep -u sagasu -x x11vnc >/dev/null; then
    printf '%s\n' 'A sign-in view is already open. Close the other sagasu-signin first.' >&2
    exit 1
fi

RUN=/run/sagasu-signin
MINUTES=15
install -d -o sagasu -g sagasu -m 0700 "$RUN"
cleanup() {
    pkill -u sagasu -x x11vnc 2>/dev/null || true
    pkill -u sagasu -f 'websockify --web /usr/share/novnc' 2>/dev/null || true
    rm -rf "$RUN"
}
trap cleanup EXIT

# A one-time password for the view. VNC passwords are at most 8 characters, so
# the view also listens on this machine only and needs your SSH key to reach.
PASSWORD=$(python3 -c "import secrets; print(''.join(secrets.choice('abcdefghjkmnpqrstuvwxyz23456789') for _ in range(8)))")
runuser -u sagasu -- x11vnc -storepasswd "$PASSWORD" "$RUN/passwd" >/dev/null 2>&1
runuser -u sagasu -- x11vnc -display :99 -auth /var/lib/sagasu/.Xauthority \
    -localhost -rfbport 5900 -rfbauth "$RUN/passwd" \
    -forever -shared -noxdamage -repeat -quiet -bg -o "$RUN/x11vnc.log" >/dev/null
if command -v websockify >/dev/null && [[ -d /usr/share/novnc ]]; then
    runuser -u sagasu -- sh -c \
        "websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900 >'$RUN/websockify.log' 2>&1 &"
fi

printf '%s\n' \
    '' \
    "A view of the server's browser is open for the next $MINUTES minutes." \
    'It is reachable only through an SSH connection that forwards ports 5900 and' \
    '6080 (the signin.sh helper on your computer already does this).' \
    '' \
    '  1. Open the view on your computer, either way:' \
    '       Finder > Go > Connect to Server >  vnc://localhost:5901' \
    '       or in a web browser:  http://localhost:6080/vnc.html?autoconnect=1&resize=scale' \
    "  2. Password for the view:  $PASSWORD" \
    '     (A viewer may say "unencrypted". The view still travels inside SSH.)' \
    '  3. In the view, sign in to Microsoft as you normally do and approve it in' \
    '     Authenticator. If Microsoft asks "Stay signed in?", Yes keeps the server' \
    '     signed in across restarts; No is safer but means signing in more often.' \
    '  4. Wait until this window says "Signed in". The view then closes by itself.' \
    ''

if /opt/sagasu/bin/sagasu-launch login --timeout $((MINUTES * 60)); then
    printf '\n%s\n' 'Signed in. The view is closed; remote agents can now use the server.'
else
    printf '%s\n' \
        '' \
        'Sign-in did not finish, and the view is closed.' \
        '  - A mistyped password, a missed approval or running out of time:' \
        '    run it again when ready.' \
        '  - A block page, an error page, or a step you do not normally see:' \
        '    do NOT try again. Stop the service (sudo systemctl disable --now' \
        '    sagasu caddy) and check with your IT department first.' >&2
    exit 1
fi
